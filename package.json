{
  "name": "desktop-clock",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "build": {
    "appId": "com.desktop.clock",
    "productName": "DesktopClock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "桌面时钟"
    }
  }
}